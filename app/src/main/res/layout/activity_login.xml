<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0A192F"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvTitle"
        android:text="WorkLink"
        android:textSize="40sp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="50dp"
        android:textStyle="bold"
        android:textColor="#E6F1FF"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Step 1: Phone Input -->
    <LinearLayout
        android:id="@+id/layoutPhoneInput"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/etPhone"
            android:hint="Phone (e.g., +1234567890)"
            android:inputType="phone"
            android:background="#112240"
            android:textColor="#FFFFFF"
            android:textColorHint="#8892B0"
            android:padding="12dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnSendOTP"
            android:text="Login with Phone"
            android:backgroundTint="#1E88E5"
            android:textColor="#FFFFFF"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Step 2: OTP Verification (Hidden by default) -->
    <LinearLayout
        android:id="@+id/layoutOTP"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/etOTP"
            android:hint="Enter Verification Code"
            android:inputType="number"
            android:maxLength="6"
            android:background="#112240"
            android:textColor="#FFFFFF"
            android:textColorHint="#8892B0"
            android:padding="12dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnLogin"
            android:text="Verify &amp; Login"
            android:backgroundTint="#1E88E5"
            android:textColor="#FFFFFF"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvRegister"
        android:text="Don't have an account? Register"
        android:textColor="#1E88E5"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Keep the old register button reference for compatibility if needed, but we'll use tvRegister -->
    <Button
        android:id="@+id/btnRegister"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</LinearLayout>